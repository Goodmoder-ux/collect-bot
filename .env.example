# ---- Required -------------------------------------------------------------

# Bot token from @BotFather (https://t.me/BotFather): /newbot.
TELEGRAM_TOKEN=

# Personal Monobank API token: https://api.monobank.ua/ (log in via the Monobank app).
# It gives read access to your statements; keep it secret.
MONOBANK_TOKEN=

# ID of the Monobank jar to watch. With your token, run:
#   curl -s -H "X-Token: $MONOBANK_TOKEN" https://api.monobank.ua/personal/client-info
# and copy the "id" of the jar from the "jars" list.
JAR_ACCOUNT_ID=

# Public link to the jar that students pay into (shown in reminders and /jar).
JAR_URL=https://send.monobank.ua/jar/XXXXXX

# Your numeric Telegram user ID (ask @userinfobot). This account becomes the admin.
ADMIN_TELEGRAM_ID=

# ---- Optional (defaults shown) --------------------------------------------

# Image tag used by compose.yaml. Pin a release for predictable upgrades.
# BOT_VERSION=latest

# SQLite database location. The Docker image defaults to /data/app.db;
# for `go run` the default is ./data/app.db.
# DB_PATH=/data/app.db

# Timezone for deadlines and the daily reminder run.
# TZ=Europe/Kyiv

# Local hour (0-23) for debtor reminders and the deadline check.
# REMINDER_HOUR=15

# How often to poll Monobank. Must be at least 60s (Monobank rate limit).
# POLL_INTERVAL=70s

# Logging: LOG_LEVEL is debug, info, warn or error; LOG_FORMAT is text or json.
# LOG_LEVEL=info
# LOG_FORMAT=text

# Localhost port of the health endpoint used by the container healthcheck; 0 disables it.
# HEALTH_PORT=8080
